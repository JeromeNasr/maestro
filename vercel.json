{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/((?!assets/|samples/|midi/|mediapipe/|models/|.*\\..*).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "connect-src 'self' blob: data: https://cdn.jsdelivr.net https://storage.googleapis.com" }
      ]
    },
    { "source": "/samples/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
